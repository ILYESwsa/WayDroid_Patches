From 0bc8e42d29e1e3debe37d8cb5316820646a423c4 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Wed, 8 Jul 2026 17:31:45 +0800
Subject: [PATCH] base: Switch to waydroid framework

Co-authored-by: SupeChicken666 <me@supechicken666.dev>
---
 core/res/Android.bp                                          | 1 +
 packages/SystemUI/Android.bp                                 | 1 +
 services/Android.bp                                          | 2 ++
 services/core/Android.bp                                     | 1 +
 .../java/com/android/server/clipboard/ClipboardService.java  | 2 +-
 .../java/com/android/server/power/PowerManagerService.java   | 2 +-
 services/java/com/android/server/SystemServer.java           | 5 +++++
 services/proguard.flags                                      | 1 +
 8 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/core/res/Android.bp b/core/res/Android.bp
index 46cae5d2b..77e6ccaca 100644
--- a/core/res/Android.bp
+++ b/core/res/Android.bp
@@ -141,6 +141,7 @@ android_app {
 
     resource_zips: [
         ":remote-color-resources-arsc-zip",
+        ":framework-waydroid-res",
     ],
 
     // Create package-export.apk, which other packages can use to get
diff --git a/packages/SystemUI/Android.bp b/packages/SystemUI/Android.bp
index eca469337..704490414 100644
--- a/packages/SystemUI/Android.bp
+++ b/packages/SystemUI/Android.bp
@@ -599,6 +599,7 @@ android_library {
         "displaylib",
         "aconfig_settings_flags_lib",
         "vendor.lineage.powershare-V1-java",
+        "framework-waydroid.static",
         "FadingEdgeLayoutLib",
         "commonutils",
     ],
diff --git a/services/Android.bp b/services/Android.bp
index 481694280..f36ca3947 100644
--- a/services/Android.bp
+++ b/services/Android.bp
@@ -156,6 +156,7 @@ filegroup {
         ":services.voiceinteraction-sources",
         ":services.wallpapereffectsgeneration-sources",
         ":services.wifi-sources",
+        ":services.waydroid-sources",
         ":framework-pm-common-shared-srcs",
         ":framework-minus-apex-aconfig-srcjars",
     ],
@@ -363,6 +364,7 @@ java_library {
         "services.usb",
         "services.voiceinteraction",
         "services.wallpapereffectsgeneration",
+        "services.waydroid",
         "services.wifi",
         "service-blobstore",
         "service-jobscheduler",
diff --git a/services/core/Android.bp b/services/core/Android.bp
index 7ded09739..c97ccda1b 100644
--- a/services/core/Android.bp
+++ b/services/core/Android.bp
@@ -255,6 +255,7 @@ java_library_static {
         "AvfBuildFlags",
         "vendor.aospa.biometrics.face",
         "vendor.waydroid.window-V1.2-java",
+        "framework-waydroid.static",
     ],
     javac_shard_size: 50,
     javacflags: [
diff --git a/services/core/java/com/android/server/clipboard/ClipboardService.java b/services/core/java/com/android/server/clipboard/ClipboardService.java
index d49d3f434..bdfe96b48 100644
--- a/services/core/java/com/android/server/clipboard/ClipboardService.java
+++ b/services/core/java/com/android/server/clipboard/ClipboardService.java
@@ -123,7 +123,7 @@ import java.util.List;
 import java.util.concurrent.TimeUnit;
 import java.util.function.Consumer;
 
-import lineageos.waydroid.WaydroidClipboard;
+import id.waydro.waydroid.WaydroidClipboard;
 
 /**
  * Implementation of the clipboard for copy and paste.
diff --git a/services/core/java/com/android/server/power/PowerManagerService.java b/services/core/java/com/android/server/power/PowerManagerService.java
index e6791d4f1..29bc72a28 100644
--- a/services/core/java/com/android/server/power/PowerManagerService.java
+++ b/services/core/java/com/android/server/power/PowerManagerService.java
@@ -160,7 +160,7 @@ import com.android.server.wm.WindowManagerInternal;
 import dalvik.annotation.optimization.NeverCompile;
 
 import lineageos.providers.LineageSettings;
-import lineageos.waydroid.Hardware;
+import id.waydro.waydroid.Hardware;
 
 import java.io.FileDescriptor;
 import java.io.PrintWriter;
diff --git a/services/java/com/android/server/SystemServer.java b/services/java/com/android/server/SystemServer.java
index b2d145443..00924c130 100644
--- a/services/java/com/android/server/SystemServer.java
+++ b/services/java/com/android/server/SystemServer.java
@@ -349,6 +349,7 @@ import java.util.concurrent.CountDownLatch;
 import java.util.concurrent.Future;
 
 import com.android.server.EvolutionSystemExService;
+import id.waydro.server.WaySystemServer;
 
 /**
  * Entry point to {@code system_server}.
@@ -3211,6 +3212,10 @@ public final class SystemServer implements Dumpable {
             reportWtf("Making " + externalServer + " ready", e);
         }
 
+        t.traceBegin("startWaydroidServices");
+        WaySystemServer.startServices(context, mSystemServiceManager);
+        t.traceEnd();
+
         // It is now time to start up the app processes...
 
         t.traceBegin("MakeLockSettingsServiceReady");
diff --git a/services/proguard.flags b/services/proguard.flags
index 4c608e3b6..acd464d0a 100644
--- a/services/proguard.flags
+++ b/services/proguard.flags
@@ -144,3 +144,4 @@
 
 # Waydroid
 -dontwarn vendor.waydroid.**
+-keep class id.waydro.** { *; }
